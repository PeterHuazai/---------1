# ============================================================
# 大学生学习管理平台 — 环境变量配置
# 注意：此文件包含敏感信息，不要提交到版本控制系统
# ============================================================

# ── MySQL 数据库连接 ──────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/campus_platform

# ── 163 邮箱 SMTP 配置 ────────────────────────────────────────
# 发件邮箱账号
EMAIL_USER=13719420290@163.com
# 163 邮箱授权码（非登录密码，在设置→客户端授权密码中生成）
EMAIL_PASS=TKyaWQKwiXfWBs4N
# 发件人显示名称
EMAIL_FROM_NAME=学习助手
# SMTP 服务器（163邮箱固定）
EMAIL_HOST=smtp.163.com
EMAIL_PORT=465

# ── 管理员邮箱 ────────────────────────────────────────────────
# 接收用户联系消息和系统告警的管理员收件邮箱
ADMIN_EMAIL=3520937281@qq.com

# ── JWT 认证 ──────────────────────────────────────────────────
SECRET_KEY=campus_platform_secret_key_please_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── 服务运行 ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
