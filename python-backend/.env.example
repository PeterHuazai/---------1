# ============================================================
# 环境变量配置模板
# 使用方法：复制本文件为 .env，然后填写对应的值
# ============================================================

# ── MySQL 数据库配置 ──────────────────────────────────────
# 本地 MySQL 连接地址，格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
# 示例（本地默认端口）：mysql+pymysql://root:123456@localhost:3306/campus_platform
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/campus_platform

# ── 163 邮箱 SMTP 配置 ────────────────────────────────────
# 发件邮箱账号
EMAIL_USER=13719420290@163.com
# 163 邮箱授权码（不是登录密码）
# 获取：登录 163 邮箱网页 → 设置 → POP3/SMTP/IMAP → 开启SMTP服务 → 生成授权码
# 已配置授权码，本地运行直接填入即可
EMAIL_PASS=GWbcp36pcDEmwLmX
# 发件人显示名称
EMAIL_FROM_NAME=学习助手

# ── JWT 认证密钥 ─────────────────────────────────────────
# 用于签发 Token，可以是任意随机字符串，建议 32 位以上
SECRET_KEY=your_random_secret_key_at_least_32_chars
# Token 有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── 服务运行配置 ─────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
